# Backend
BACKEND_PORT=4000
FRONTEND_PORT=3000
ADMINER_PORT=8081
DB_PORT=5432
PORT=4000
DATABASE_URL=postgresql://postgres:password@db:5432/groceries

# Cookies: set true ONLY when the browser uses HTTPS for the site.
# If you open the app as http://host:3000, leave this false — Secure cookies
# will not be stored by the browser and every post-login API call will 401.
COOKIE_SECURE=false

# Only needed for Vite dev against a separate API origin (comma-separated)
# CORS_ORIGIN=http://localhost:5173

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=groceries
